<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../SilverCraft.CSCore.targets" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>openmpt support for SilverCraft.CSCore</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/thesilvercraft/cscore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thesilvercraft/cscore/tree/master/SilverCraft.CSCore.OpenMPT</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SilverCraft.CSCore\SilverCraft.CSCore.csproj" />
    <PackageReference Include="SilverAudioPlayer.Shared" Version="7.4.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>