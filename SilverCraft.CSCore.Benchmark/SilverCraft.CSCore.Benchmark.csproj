<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BenchmarkPackageId Condition="'$(BenchmarkPackageId)' == ''">SilverCraft.CSCore</BenchmarkPackageId>
    <BenchmarkLibraryVersion Condition="'$(BenchmarkLibraryVersion)' == ''">0.2.0-beta</BenchmarkLibraryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" />
    <PackageReference Include="YellowDogMan.CSCoreFork" Version="1.2.1.2-ydm-0.1.19" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetCSCore)' == 'true'">
    <PackageReference Include="$(BenchmarkPackageId)" Version="$(BenchmarkLibraryVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetCSCore)' != 'true'">
    <ProjectReference Include="../SilverCraft.CSCore/SilverCraft.CSCore.csproj" />
  </ItemGroup>
</Project>
