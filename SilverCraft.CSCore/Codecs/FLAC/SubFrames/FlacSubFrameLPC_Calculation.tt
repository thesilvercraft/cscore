<#+
        for (var o = maxOrder; o >= minOrder; o--)
        {
#>
                        case <#= o #>:
                        {
<#+
            if (hoist)
            {
                for (var k = o - 1; k >= 0; k--)
                {
#>
                            <#= isWide ? "long" : "int" #> q<#= k #> = q[<#= k #>];
<#+
                }
            }
#>
                            for (int i = order; i < length; i++)
                            {
                                z =
<#+
            for (var n = o - 1; n >= 0; n--)
            {
                var qExpr = hoist ? "q" + n : "q[" + n + "]";
                var sampleExpr = (isWide && !hoist) ? "(long)pDest[i - " + (n + 1) + "]" : "pDest[i - " + (n + 1) + "]";
#>
                                    (<#= qExpr #> * <#= sampleExpr #>)<#= n > 0 ? " +" : ";" #>
<#+
            }
#>
                                pDest[i] = pRes[i] + <#= isWide ? "(int)" : "" #>(z >> lpcShiftNeeded);
